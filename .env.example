# Скопируйте в .env и заполните. Файл .env не коммитится.

# SMTP для отправки паролей. Если SMTP_HOST пустой, письма печатаются в консоль сервера.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# SMTP_USE_SSL=true для порта 465; SMTP_STARTTLS=true для порта 587
SMTP_USE_SSL=false
SMTP_STARTTLS=true

# Срок жизни сессии в часах (по умолчанию 7 дней)
SESSION_TTL_HOURS=168

# Включить после настройки HTTPS
COOKIE_SECURE=false
